<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Exercises each micro-kernel directly so the codegen gate can capture it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>tensile-diag</AssemblyName>

    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tensile/Tensile.csproj" />
    <ProjectReference Include="../../src/Tensile.Kernels/Tensile.Kernels.csproj" />
    <ProjectReference Include="../../src/Tensile.Interop.Blis/Tensile.Interop.Blis.csproj" />
  </ItemGroup>

</Project>
