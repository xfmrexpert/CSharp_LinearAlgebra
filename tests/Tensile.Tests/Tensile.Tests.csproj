<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- The primitive-layer contracts drive the kernels with pointers, as the kernels are written. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3 for Assert.Skip: a kernel the host CPU cannot run must be
         reported skipped, never silently passed. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tensile/Tensile.csproj" />
    <ProjectReference Include="../../src/Tensile.Kernels/Tensile.Kernels.csproj" />
    <ProjectReference Include="../../src/Tensile.Interop.Blis/Tensile.Interop.Blis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
