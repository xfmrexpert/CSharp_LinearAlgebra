<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Sources are cleared and re-added explicitly so a machine-level NuGet.config
    cannot inject a feed. The library itself takes no package references; only
    the test project does.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
