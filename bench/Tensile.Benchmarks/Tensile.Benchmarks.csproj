<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- The benchmarks hand the kernels raw operands so nothing but the kernel is timed. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- BenchmarkDotNet runs each benchmark in a generated child process and
         needs an optimized, non-tiered build to measure. Do not add
         TieredCompilation settings here: BDN sets them per job. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>

    <!-- BenchmarkDotNet's generated harness trips analyzers we treat as errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT, so it passes the forkability test. Benchmarks only; the library
         itself still takes no package references. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tensile/Tensile.csproj" />
    <ProjectReference Include="../../src/Tensile.Kernels/Tensile.Kernels.csproj" />
  </ItemGroup>

</Project>
